{
  "description": "Checks the conventional-commit format and subject length of each new commit. Never blocks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-lint.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
